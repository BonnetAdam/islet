        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages d’Islet"
          }
        }
      }
    },
    "Islet never asks for Screen Recording, Full Disk Access or Input Monitoring. It sees that the microphone is in use without ever listening to it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet ne demande jamais l’Enregistrement de l’écran, l’Accès complet au disque ni la Surveillance de l’entrée. Il voit que le micro est utilisé sans jamais l’écouter."
          }
        }
      }
    },
    "Islet stays out of the Dock and the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet reste hors du Dock et de la barre des menus."
          }
        }
      }
    },
